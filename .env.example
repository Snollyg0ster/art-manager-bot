# Токен от @BotFather
BOT_TOKEN=

# Совпадает с docker-compose.yml
DATABASE_URL=postgres://mutual:mutual@127.0.0.1:5432/mutual
REDIS_URL=redis://127.0.0.1:6379

# RFC §8.2: grace на случайный выход-возврат, мс
GRACE_MS=900000

# RFC §11: лимит на result.json вместо стримового парсера, байт
MAX_EXPORT_BYTES=20971520

# RFC §10: ежесуточная сверка
RECONCILE_CRON=0 4 * * *
